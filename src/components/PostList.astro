---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;

// 발행 연도별로 묶습니다. posts는 이미 최신순으로 정렬되어 들어옵니다.
const byYear = posts.reduce<Map<number, CollectionEntry<'blog'>[]>>((acc, post) => {
	const year = post.data.pubDate.getFullYear();
	acc.set(year, [...(acc.get(year) ?? []), post]);
	return acc;
}, new Map());
---

{
	[...byYear].map(([year, yearPosts]) => (
		<section class="year">
			<h2>{year}</h2>
			<ul>
				{yearPosts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<span class="date">
								<FormattedDate date={post.data.pubDate} />
							</span>
							<span class="title">{post.data.title}</span>
						</a>
						{post.data.category && <span class="cat">{post.data.category}</span>}
					</li>
				))}
			</ul>
		</section>
	))
}

<style>
	.year {
		margin-bottom: 2.5em;
	}
	.year h2 {
		margin: 0 0 0.4em 0;
		padding-bottom: 0.2em;
		border-bottom: 1px solid rgba(var(--gray), 20%);
		color: rgb(var(--gray));
		font-size: 1rem;
		letter-spacing: 0.08em;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		display: flex;
		align-items: baseline;
		gap: 0.8em;
		padding: 0.45em 0;
	}
	li a {
		display: flex;
		align-items: baseline;
		gap: 0.9em;
		flex: 1;
		min-width: 0;
		text-decoration: none;
	}
	.date {
		flex: none;
		width: 9.2em;
		color: rgb(var(--gray));
		font-size: 0.8rem;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.title {
		color: rgb(var(--black));
		font-size: 0.95rem;
		line-height: 1.5;
	}
	li a:hover .title {
		color: var(--accent);
		text-decoration: underline;
	}
	.cat {
		flex: none;
		color: rgb(var(--gray));
		font-size: 0.72rem;
		white-space: nowrap;
	}
	@media (max-width: 720px) {
		li {
			flex-direction: column;
			gap: 0.15em;
			padding: 0.6em 0;
			border-bottom: 1px solid rgba(var(--gray), 12%);
		}
		li a {
			flex-direction: column;
			gap: 0.15em;
		}
		.date {
			width: auto;
		}
		.cat {
			font-size: 0.7rem;
		}
	}
</style>
