---
interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tags">
			{tags.map((tag) => (
				<li>{tag}</li>
			))}
		</ul>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.tags li {
		padding: 0.15em 0.7em;
		border: 1px solid rgba(var(--gray), 35%);
		border-radius: 999px;
		color: rgb(var(--gray));
		font-size: 0.75rem;
		line-height: 1.6;
		white-space: nowrap;
	}
</style>
