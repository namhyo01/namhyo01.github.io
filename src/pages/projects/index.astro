---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import TagList from '../../components/TagList.astro';
import { SITE_TITLE } from '../../consts';
import { getProjects } from '../../lib/collections';

const projects = await getProjects();
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`Projects · ${SITE_TITLE}`}
			description="지금까지 만든 것들과, 어떻게 만들었는지에 대한 기록입니다."
		/>
		<style>
			main {
				width: 960px;
			}
			.page-title {
				margin-bottom: 2rem;
			}
			.page-title p {
				margin: 0;
				color: rgb(var(--gray));
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 2rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.card {
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
				padding: 1.2rem;
				border: 1px solid rgba(var(--gray), 20%);
				border-radius: 12px;
				background: white;
				transition: 0.2s ease;
			}
			.card:hover {
				border-color: rgba(var(--accent-rgb, 35, 55, 255), 40%);
				box-shadow: var(--box-shadow);
			}
			.card img {
				width: 100%;
				border-radius: 8px;
			}
			.card h2 {
				margin: 0;
				font-size: 1.4rem;
				line-height: 1.3;
			}
			.card h2 a {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.card:hover h2 a {
				color: var(--accent);
			}
			.period {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.8rem;
			}
			.desc {
				flex: 1;
				margin: 0;
				color: rgb(var(--gray-dark));
				font-size: 0.95rem;
			}
			.badge {
				align-self: flex-start;
				padding: 0.1em 0.6em;
				border-radius: 4px;
				background: rgba(var(--gray-light));
				color: rgb(var(--gray));
				font-size: 0.7rem;
				letter-spacing: 0.05em;
				text-transform: uppercase;
			}
			.empty {
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.grid {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-title">
				<h1>Projects</h1>
				<p>만든 것들과, 만들면서 마주친 문제들을 정리했습니다.</p>
			</div>
			{projects.length === 0 && <p class="empty">아직 등록한 프로젝트가 없습니다.</p>}
			<ul class="grid">
				{
					projects.map((project) => (
						<li class="card">
							{project.data.featured && <span class="badge">Featured</span>}
							{project.data.heroImage && (
								<a href={`/projects/${project.id}/`}>
									<Image width={640} height={360} src={project.data.heroImage} alt="" />
								</a>
							)}
							<h2>
								<a href={`/projects/${project.id}/`}>{project.data.title}</a>
							</h2>
							<p class="period">
								<FormattedDate date={project.data.startDate} /> ~{' '}
								{project.data.endDate ? (
									<FormattedDate date={project.data.endDate} />
								) : (
									'진행 중'
								)}
							</p>
							<p class="desc">{project.data.description}</p>
							<TagList tags={project.data.stack} />
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
