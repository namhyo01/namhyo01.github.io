---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR, EMAIL, GITHUB_URL, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`About · ${SITE_TITLE}`} description={`${AUTHOR}에 대한 소개입니다.`} />
		<style>
			h1 {
				margin-bottom: 0.2em;
				font-size: 2.4rem;
			}
			.lead {
				margin-top: 0;
				color: rgb(var(--gray));
			}
			h2 {
				margin-top: 2em;
				font-size: 1.4rem;
			}
			dl {
				display: grid;
				grid-template-columns: 8rem 1fr;
				gap: 0.6em 1em;
				margin: 0;
			}
			dt {
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			dd {
				margin: 0;
			}
			ul {
				padding-left: 1.2em;
			}
			li {
				margin-bottom: 0.4em;
			}
			@media (max-width: 720px) {
				dl {
					grid-template-columns: 1fr;
					gap: 0.2em;
				}
				dd {
					margin-bottom: 0.8em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>About</h1>
			<p class="lead">여기에 한 줄 소개를 적어주세요.</p>

			<p>
				안녕하세요, {AUTHOR}입니다. 이 페이지는 아직 초안입니다 — 어떤 일을 해왔고, 무엇에 관심이
				있고, 어떤 방식으로 일하는지를 적어두면 포트폴리오로서 가장 먼저 읽히는 곳이 됩니다.
			</p>

			<h2>이런 걸 합니다</h2>
			<ul>
				<li>관심 분야나 주로 다루는 기술을 적어주세요.</li>
				<li>최근에 파고들고 있는 주제를 적어주세요.</li>
				<li>앞으로 해보고 싶은 것을 적어주세요.</li>
			</ul>

			<h2>경험</h2>
			<dl>
				<dt>2024 – 현재</dt>
				<dd>소속 / 역할 / 한 일을 한 줄로</dd>
				<dt>2022 – 2024</dt>
				<dd>소속 / 역할 / 한 일을 한 줄로</dd>
			</dl>

			<h2>연락</h2>
			<dl>
				<dt>GitHub</dt>
				<dd><a href={GITHUB_URL} target="_blank" rel="noopener">{GITHUB_URL}</a></dd>
				<dt>Email</dt>
				<dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
			</dl>
		</main>
		<Footer />
	</body>
</html>
