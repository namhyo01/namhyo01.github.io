---
import BaseHead from '../../../components/BaseHead.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import PostList from '../../../components/PostList.astro';
import { SITE_TITLE } from '../../../consts';
import { getPosts, topCategory } from '../../../lib/collections';

export async function getStaticPaths() {
	const posts = await getPosts();
	const tops = [...new Set(posts.map((p) => topCategory(p.data.category)).filter(Boolean))];
	return tops.map((category) => ({
		params: { category },
		props: { category, posts: posts.filter((p) => topCategory(p.data.category) === category) },
	}));
}

const { category, posts } = Astro.props;
const total = (await getPosts()).length;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`${category} · ${SITE_TITLE}`}
			description={`'${category}' 분류의 글 ${posts.length}개.`}
		/>
		<style>
			main {
				width: 860px;
			}
			.page-title {
				margin-bottom: 1.2rem;
			}
			.page-title h1 {
				margin-bottom: 0.1em;
			}
			.page-title p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-title">
				<h1>{category}</h1>
				<p>{posts.length}개의 글</p>
			</div>
			<CategoryNav active={category} total={total} />
			<PostList posts={posts} />
		</main>
		<Footer />
	</body>
</html>
